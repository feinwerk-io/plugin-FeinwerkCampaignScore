{# Feinwerk kit: the Feinwerk Connector installer page (ConnectorInstaller/ConnectorInstaller.php, Controller::
   connectorInstaller and connectorInstallerRun). Super users only. installerState: install (one button: Matomo's own
   Marketplace installer, then activate), activate (one button), console (files there, plugin administration off: the
   command), manual, php, wordpress (instructions, no button).
   installerError: Matomo's reason after a failed click (raw only where Matomo marks it as HTML). Matomo's own card and
   button classes, so light and dark follow Matomo. #}
{% extends 'admin.twig' %}

{% set title %}{{ 'FeinwerkCampaignScore_ConnectorInstallerTitle'|translate }}{% endset %}

{% block content %}
<div class="card fwci">
    <div class="card-content">
        <h2 class="card-title">{{ title }}</h2>
        <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerIntro'|translate }}</p>

        {% if installerClickAgain %}
            <div class="alert alert-info fwci__again" role="status">{{ 'FeinwerkCampaignScore_ConnectorInstallerClickAgain'|translate }}</div>
        {% endif %}
        {% if installerError %}
            <div class="alert alert-danger fwci__error">
                {% if installerError.html %}{{ installerError.message|raw }}{% else %}{{ installerError.message }}{% endif %}
            </div>
        {% endif %}

        {% if installerState == 'install' or installerState == 'activate' %}
            {% if installerState == 'install' %}
                <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerInstallText'|translate }}</p>
            {% else %}
                <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerActivateText'|translate }}</p>
            {% endif %}
            <p>
                <a class="btn fwci__run" href="{{ linkTo({'module': 'FeinwerkCampaignScore', 'action': 'connectorInstallerRun', 'nonce': installerNonce, 'retry': installerClickAgain ? 1 : 0}) }}"
                   data-fwci-busy="{{ (installerState == 'install' ? 'FeinwerkCampaignScore_ConnectorInstallerInstalling' : 'FeinwerkCampaignScore_ConnectorInstallerActivating')|translate }}">
                    {{ (installerState == 'install' ? 'FeinwerkCampaignScore_ConnectorInstallerButton' : 'FeinwerkCampaignScore_ConnectorInstallerButtonActivate')|translate }}
                </a>
            </p>
            <p class="fwci__note">{{ 'FeinwerkCampaignScore_ConnectorInstallerPasswordNote'|translate }}</p>
        {% elseif installerState == 'console' %}
            <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerConsole'|translate }}</p>
            <pre class="fwci__command"><code>{{ installerConsoleCommand }}</code></pre>
        {% elseif installerState == 'wordpress' %}
            <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerWordPress'|translate }}</p>
            {% if installerWordPressUrl %}
                <p><a class="btn" href="{{ installerWordPressUrl }}">{{ 'FeinwerkCampaignScore_ConnectorInstallerWordPressLink'|translate }}</a></p>
            {% endif %}
        {% elseif installerState == 'php' %}
            <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerPhp'|translate(installerPhpFloor) }}</p>
        {% elseif installerState == 'manual' %}
            <p>{{ 'FeinwerkCampaignScore_ConnectorInstallerManual'|translate }}</p>
            <ol class="fwci__steps">
                <li>{{ 'FeinwerkCampaignScore_ConnectorInstallerManualStep1'|translate }}
                    <a href="{{ installerLinks.marketplace }}" target="_blank" rel="noopener">plugins.matomo.org</a>,
                    <a href="{{ installerLinks.download }}" target="_blank" rel="noopener">plugins.feinwerk.io</a></li>
                <li>{{ 'FeinwerkCampaignScore_ConnectorInstallerManualStep2'|translate('<code>FeinwerkMarketplaceConnector</code>')|raw }}</li>
                {% if installerPluginsAdmin %}
                <li>{{ 'FeinwerkCampaignScore_ConnectorInstallerManualStep3'|translate }}</li>
                {% else %}
                <li>{{ 'FeinwerkCampaignScore_ConnectorInstallerManualStep3Console'|translate }}
                    <code>{{ installerConsoleCommand }}</code></li>
                {% endif %}
            </ol>
        {% else %}
            <p><a class="btn" href="{{ installerConnectorUrl }}">{{ 'FeinwerkCampaignScore_ConnectorInstallerOpen'|translate }}</a></p>
        {% endif %}
    </div>
</div>
{% endblock %}
