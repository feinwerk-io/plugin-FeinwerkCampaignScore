{# The picture of the guide banner (templates/_scoreSplit.twig). A link builder card of Feinwerk Campaigns: three spellings
   flow into the campaign field, the values come from the convention, the link is clean. Parameter names only, no
   language. artId keeps the SVG ids unique on the page. Nothing is loaded from outside. #}
{% set a = artId|default('Art') %}
<svg class="fwcs-art" viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" role="presentation" focusable="false">
    <defs>
        <radialGradient id="fwcsArtBg{{ a }}" cx="82%" cy="8%" r="120%"><stop offset="0" stop-color="#17605b"/><stop offset=".55" stop-color="#0c2321"/><stop offset="1" stop-color="#081211"/></radialGradient>
        <radialGradient id="fwcsArtGlow{{ a }}" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#8ee6c8" stop-opacity=".22"/><stop offset="1" stop-color="#8ee6c8" stop-opacity="0"/></radialGradient>
        <linearGradient id="fwcsArtCard{{ a }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#143b37"/><stop offset="1" stop-color="#0d2624"/></linearGradient>
        <linearGradient id="fwcsArtEdge{{ a }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9fd8d2" stop-opacity="0"/><stop offset=".5" stop-color="#9fd8d2" stop-opacity=".7"/><stop offset="1" stop-color="#9fd8d2" stop-opacity="0"/></linearGradient>
        <linearGradient id="fwcsArtFade{{ a }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset=".7" stop-color="#fff" stop-opacity="0"/></linearGradient>
        <mask id="fwcsArtGridMask{{ a }}"><rect width="320" height="200" fill="url(#fwcsArtFade{{ a }})"/></mask>
        <filter id="fwcsArtShadow{{ a }}" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity=".45"/></filter>
    </defs>
    <rect width="320" height="200" fill="url(#fwcsArtBg{{ a }})"/>
    <g mask="url(#fwcsArtGridMask{{ a }})" stroke="#9fd8d2" stroke-opacity=".09" stroke-width="1">
        <path d="M0 20H320M0 40H320M0 60H320M0 80H320M0 100H320M0 120H320M0 140H320M0 160H320M0 180H320M20 0V200M40 0V200M60 0V200M80 0V200M100 0V200M120 0V200M140 0V200M160 0V200"/>
    </g>
    <ellipse cx="226" cy="92" rx="120" ry="90" fill="url(#fwcsArtGlow{{ a }})"/>

    <g font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" font-size="8.5">
        <g fill="none" stroke="#9fd8d2" stroke-opacity=".45" stroke-dasharray="2.5 2.5">
            <rect x="12" y="46" width="76" height="17" rx="4"/>
            <rect x="12" y="72" width="76" height="17" rx="4"/>
            <rect x="12" y="98" width="76" height="17" rx="4"/>
        </g>
        <g fill="#f7f5f0">
            <text x="19" y="58" fill-opacity=".62">Black Friday</text>
            <text x="19" y="84" fill-opacity=".5">black_friday</text>
            <text x="19" y="110" fill-opacity=".4">BlackFriday</text>
        </g>
        <g fill="none" stroke="#8ee6c8" stroke-width="1.2" stroke-linecap="round">
            <path d="M88 54.5 C108 54.5 110 70 128 70" stroke-opacity=".75"/>
            <path d="M88 80.5 C104 80.5 112 70 128 70" stroke-opacity=".6"/>
            <path d="M88 106.5 C108 106.5 110 70 128 70" stroke-opacity=".45"/>
        </g>
        <circle cx="128" cy="70" r="2.2" fill="#8ee6c8"/>
    </g>

    <g filter="url(#fwcsArtShadow{{ a }})">
        <rect x="134" y="22" width="174" height="156" rx="9" fill="url(#fwcsArtCard{{ a }})" stroke="#9fd8d2" stroke-opacity=".22"/>
    </g>
    <path d="M146 22.5H296" stroke="url(#fwcsArtEdge{{ a }})" stroke-width="1"/>
    <g transform="translate(146 33)">
        <circle cx="2.5" cy="2.5" r="1.7" fill="#3f8e83"/><circle cx="8.5" cy="2.5" r="2.1" fill="#9fd8d2"/><circle cx="14.5" cy="2.5" r="1.7" fill="#3f8e83"/>
        <circle cx="8.5" cy="8.5" r="2.4" fill="#8ee6c8"/>
    </g>
    <g font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif">
        <rect x="262" y="31" width="36" height="14" rx="7" fill="#8ee6c8"/>
        <text x="280" y="41" fill="#0a1514" font-size="8" font-weight="700" text-anchor="middle">100 %</text>
    </g>

    <g font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace">
        <g font-size="6.6" fill="#9fd8d2" fill-opacity=".7">
            <text x="146" y="60">mtm_campaign</text>
            <text x="146" y="95">mtm_source</text>
            <text x="146" y="130">mtm_medium</text>
        </g>
        <rect x="146" y="63" width="150" height="19" rx="4.5" fill="#0a1514" stroke="#8ee6c8" stroke-width="1.1"/>
        <text x="153" y="76" font-size="8.6" fill="#f7f5f0">black-friday-2026</text>
        <circle cx="286" cy="72.5" r="5" fill="#8ee6c8"/>
        <path d="M283.6 72.6 L285.4 74.4 L288.6 71" fill="none" stroke="#0a1514" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>

        <rect x="146" y="98" width="150" height="19" rx="4.5" fill="#0a1514" stroke="#9fd8d2" stroke-opacity=".28"/>
        <text x="153" y="111" font-size="8.6" fill="#f7f5f0" fill-opacity=".9">newsletter</text>
        <path d="M284 105.5 l3 3 l3 -3" fill="none" stroke="#9fd8d2" stroke-opacity=".6" stroke-width="1.1"/>

        <rect x="146" y="133" width="150" height="19" rx="4.5" fill="#0a1514" stroke="#9fd8d2" stroke-opacity=".28"/>
        <text x="153" y="146" font-size="8.6" fill="#f7f5f0" fill-opacity=".9">email</text>
        <path d="M284 140.5 l3 3 l3 -3" fill="none" stroke="#9fd8d2" stroke-opacity=".6" stroke-width="1.1"/>

        <text x="146" y="168" font-size="6.4" fill="#f7f5f0" fill-opacity=".55">?mtm_campaign=<tspan fill="#8ee6c8" fill-opacity="1">black-friday-2026</tspan>&amp;mtm_source=…</text>
    </g>
</svg>
